# =========================================================================
#  Solaire Energie — variables d'environnement
#  Copiez ce fichier en `.env.local` et renseignez les valeurs nécessaires.
#  Toutes les variables sont OPTIONNELLES : sans configuration, les leads
#  sont écrits dans .data/leads.json (fallback dev).
# =========================================================================

# URL publique du site (utilisée pour les metadata, le sitemap et robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.solaire-energie.fr

# -------------------------------------------------------------------------
#  Stockage des leads — un seul sink est actif, choisi automatiquement
#  dans cet ordre de priorité : Supabase > Resend > fichier local.
# -------------------------------------------------------------------------

# 1) Supabase (prioritaire). Nécessite une table `leads` (voir README).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optionnel : nom de table (défaut : "leads")
SUPABASE_LEADS_TABLE=leads

# 2) Resend (email de notification si Supabase non configuré)
RESEND_API_KEY=
# Destinataire(s) des notifications de lead (séparés par des virgules)
LEAD_NOTIFICATION_EMAIL=contact@energies-plus.fr
# Expéditeur (doit appartenir à un domaine vérifié dans Resend)
LEAD_NOTIFICATION_FROM=Solaire Energie <leads@energies-plus.fr>

# 3) Aucun des deux : fallback fichier local .data/leads.json (rien à configurer)

# -------------------------------------------------------------------------
#  Tracking (tous optionnels — laissés vides, les scripts ne se chargent pas)
# -------------------------------------------------------------------------

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Meta Pixel (événement "Lead" déclenché sur /merci)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads — conversion déclenchée sur /merci
NEXT_PUBLIC_GADS_CONVERSION_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=
